# Copy this file to .env in the folder you run manage.py from, and fill in APIFY_API_TOKEN.
# Never share the real .env: it holds the Apify token.

# ===== Apify =====
APIFY_API_TOKEN=

# Each board's Apify actor. If a line is missing or blank, that board is skipped with a message
# and the other boards still run.

# LinkedIn, Indeed, Glassdoor, The Muse and the remote boards all use this one actor.
# https://apify.com/flash_scraper/multi-jobboard-scraper
APIFY_MULTI_JOBBOARD_ACTOR=flash_scraper/multi-jobboard-scraper

# https://apify.com/solidcode/dice-scraper
APIFY_DICE_ACTOR=solidcode/dice-scraper

# https://apify.com/unfenced-group/monster-scraper
APIFY_MONSTER_ACTOR=unfenced-group/monster-scraper
# Empty = all of the US. Or a state / city to narrow it, e.g. TX or "Austin, TX".
MONSTER_LOCATION=

# https://apify.com/ahmed_jasarevic/careerbuilder-scraper
# Called once per role. The role must have more than one word (CareerBuilder rejects single words).
APIFY_CAREERBUILDER_ACTOR=ahmed_jasarevic/careerbuilder-scraper

# https://apify.com/memo23/ziprecruiter-scraper
APIFY_ZIPRECRUITER_ACTOR=memo23/ziprecruiter-scraper

# jobscrawler/jobright-scraper or scrapeai/jobright-scraper (both work, same output).
# JobRight blocks runs that go through a proxy, so the code runs it without one.
APIFY_JOBRIGHT_ACTOR=jobscrawler/jobright-scraper

# true = copy each actor's own log into ours (very noisy). When a board returns nothing, its log
# is checked anyway and the reason is printed.
APIFY_STREAM_LOGS=false
# true = print each actor call's input, run id, status, row count, cost and Apify Console link.
APIFY_LOG_RUNS=true

# ===== Board options =====
# The Muse only accepts "City, ST", so it is searched in these cities (';'-separated) in one run.
MUSE_LOCATIONS=New York, NY;San Francisco, CA;Austin, TX
# true = drop Muse jobs that have no US city (remote jobs there are often outside the US).
MUSE_US_ONLY=true
# How many Muse jobs the actor looks at per city before the title filter. Most get dropped,
# so this is not the number of jobs you get. Higher = more matches, slower run.
MUSE_SCAN_PER_CITY=20

# true = the multi-board actor only returns jobs whose title fits the role. Dropped rows are not
# billed. false = no title filter.
MULTI_REQUIRE_TITLE=true
# How far that actor looks ahead per call, as a multiple of the jobs still needed. Filtered rows
# are not billed, so a bigger number means fewer actor runs, not higher cost.
MULTI_SCAN_FACTOR=6

# How a job title is checked against the role:
#   distinctive = the role's special words must be in the title
#                 ("embedded software engineer" keeps "Sr Embedded Engineer")
#   all         = every word of the role must be in the title (stricter, fewer jobs)
TITLE_MATCH_MODE=distinctive
# Words that are too common to count as special (comma-separated). Empty = the built-in list:
# engineer, engineers, engineering, software, developer, development, senior, sr, junior, jr,
# lead, staff, principal, associate, i, ii, iii, iv, systems, system, specialist, and, of, the
TITLE_GENERIC_WORDS=

# true = search ZipRecruiter for the exact role phrase. Without quotes it returns many unrelated
# (but still billed) jobs.
ZIPRECRUITER_EXACT_PHRASE=true
# true = keep US jobs only (ZipRecruiter also lists some Canadian jobs).
ZIPRECRUITER_US_ONLY=true

# ===== How the scrape runs =====
# How many board searches run at the same time (per_board scope only).
# Each running actor uses some of your Apify account's memory. Lower this if runs fail with a
# memory-limit error.
SCRAPE_PARALLEL_BOARDS=8
# true  = all searches of all roles share one queue, so a new search starts as soon as any
#         finishes, instead of waiting for the slowest board of the current role.
# false = one role at a time (its boards in parallel), the old behaviour.
# The summary table at the end is the same either way.
SCRAPE_SHARED_QUEUE=true
# A board that returned nothing because it was blocked or broke is run again this many times.
# 0 = no retry.
SCRAPE_RETRY_FAILED=1

# ===== Database =====
# The app uses the Django project's database settings (DATABASES). It must be PostgreSQL.
# Which DATABASES entry to use:
JOB_SCRAPER_DB_ALIAS=default

# ===== Scrape limits =====
# Every value below is checked at the start of a run. A wrong value stops the run before anything
# is scraped. Any of them can be changed for one run on the command line
# (python manage.py daily_run --help).

# Jobs per role. per_board: this many from every board. per_role: this many in total for the role.
SCRAPE_MAX_JOBS_PER_ROLE=50

# per_board = SCRAPE_MAX_JOBS_PER_ROLE from each board (costs about "number of boards" times more)
# per_role  = SCRAPE_MAX_JOBS_PER_ROLE in total, filled from the boards in SCRAPE_SOURCES order
SCRAPE_LIMIT_SCOPE=per_board

# What counts toward the limit:
#   inserted = only new jobs. Jobs we already have are still refreshed but don't count, so the
#              scraper goes deeper to find new ones.
#   all      = every fresh job that fits the role counts, new or not.
SCRAPE_COUNT_MODE=inserted

# A different limit for some boards, e.g. glassdoor:30,dice:20. Empty = all use the main limit.
# (Glassdoor rarely has more than about 30 per search.)
SCRAPE_BOARD_LIMITS=

# Boards to run, comma-separated (the order matters for per_role). Empty = all default boards.
# Remove a board here to switch it off.
# Known: linkedin, indeed, glassdoor, dice, monster, careerbuilder, ziprecruiter, jobright, muse,
# remotive, jobicy, himalayas, hn_hiring, remoteok, weworkremotely, working_nomads,
# devitjobs_us, devitjobs_uk
# The 8 required boards: linkedin,indeed,glassdoor,dice,monster,careerbuilder,ziprecruiter,jobright
SCRAPE_SOURCES=

# Only keep jobs posted in the last N days. 1 = last 24 hours (each board's own 24-hour filter is
# used, and our own check keeps today and yesterday, as most boards only give a date).
SCRAPE_FRESHNESS_DAYS=1
# Keep jobs without a posting date? true or false.
SCRAPE_KEEP_UNDATED=true
# Mark a job inactive (the row is kept) when no scrape has seen it for this many days.
SCRAPE_INACTIVE_AFTER_DAYS=45
# Cost limit: rows fetched per board per role are capped at this times the board's limit
# (40 x 50 = 2,000). Every row the actor returns is billed. Matters most with inserted mode.
SCRAPE_MAX_FETCH_MULTIPLIER=40

# ===== Government visa data =====
# Folder with the lca, perm, uscis-hub and everify subfolders.
DATA_DIR=./data
