SCRAPE_LIMIT_SCOPE=per_board
SCRAPE_COUNT_MODE=inserted
SCRAPE_BOARD_LIMITS=
SCRAPE_SOURCES=
SCRAPE_FRESHNESS_DAYS=1
SCRAPE_KEEP_UNDATED=true
SCRAPE_INACTIVE_AFTER_DAYS=45
SCRAPE_MAX_FETCH_MULTIPLIER=40

