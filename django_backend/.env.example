APIFY_CAREERBUILDER_ACTOR=ahmed_jasarevic/careerbuilder-scraper
APIFY_ZIPRECRUITER_ACTOR=memo23/ziprecruiter-scraper
APIFY_JOBRIGHT_ACTOR=jobscrawler/jobright-scraper
APIFY_STREAM_LOGS=false
APIFY_LOG_RUNS=true

# ===== Board options =====
MUSE_LOCATIONS=New York, NY;San Francisco, CA;Austin, TX
MUSE_US_ONLY=true
MUSE_SCAN_PER_CITY=20
MULTI_REQUIRE_TITLE=true
MULTI_SCAN_FACTOR=6
TITLE_MATCH_MODE=distinctive
TITLE_GENERIC_WORDS=
ZIPRECRUITER_EXACT_PHRASE=true
ZIPRECRUITER_US_ONLY=true

# ===== Scrape concurrency =====
SCRAPE_PARALLEL_BOARDS=8
SCRAPE_SHARED_QUEUE=true
SCRAPE_RETRY_FAILED=1

# ===== PostgreSQL Database for job_scraper =====
